<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Qualifier overlays replace a style wholesale, so shared attrs live on a base style. -->
    <style name="Theme.Semo.Base" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FCFCFD</item>
        <item name="android:statusBarColor">#FCFCFD</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.Semo" parent="Theme.Semo.Base" />
</resources>
